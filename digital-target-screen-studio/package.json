{
  "name": "digital-target-screen-studio",
  "productName": "Digital Target Screen Studio",
  "version": "1.0.0",
  "description": "Professional screen recorder and screenshot studio by Digital Target",
  "author": {
    "name": "Digital Target"
  },
  "homepage": "https://digitaltarget.example",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "brand": "node scripts/generate-brand-assets.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "dist:win": "npm run typecheck && npm run build && npm run ffmpeg:fetch && npm run licenses && electron-builder --win --x64 --publish never",
    "dist:win:dir": "npm run build && npm run ffmpeg:fetch && npm run licenses && electron-builder --win --x64 --dir --publish never",
    "dist:linux:dir": "npm run build && npm run licenses && electron-builder --linux --x64 --dir --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.54.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resedit": "^3.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
